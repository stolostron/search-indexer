  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "k6" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active VUs",
      "type": "stat",
      "targets": [{ "query": "SELECT last(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "datasource": { "type": "influxdb", "uid": "k6" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Total Requests",
      "type": "stat",
      "targets": [{ "query": "SELECT sum(\"value\") FROM \"http_reqs\" WHERE $timeFilter", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "datasource": { "type": "influxdb", "uid": "k6" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Error Rate",
      "type": "stat",
      "targets": [{ "query": "SELECT last(\"value\") FROM \"http_req_failed\" WHERE $timeFilter", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "datasource": { "type": "influxdb", "uid": "k6" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "decbytes", "thresholds": { "steps": [{ "color": "blue", "value": null }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Data Sent",
      "type": "stat",
      "targets": [{ "query": "SELECT sum(\"value\") FROM \"data_sent\" WHERE $timeFilter", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "title": "Indexer Sync",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "k6" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "pointSize": 5, "lineWidth": 1 } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "title": "Sync Request Duration",
      "type": "timeseries",
      "targets": [
        { "alias": "p95 full", "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE \"sync_type\" = 'full' AND $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series" },
        { "alias": "p95 delta", "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE \"sync_type\" = 'delta' AND $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series" },
        { "alias": "p50 full", "query": "SELECT percentile(\"value\", 50) FROM \"http_req_duration\" WHERE \"sync_type\" = 'full' AND $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series" },
        { "alias": "p50 delta", "query": "SELECT percentile(\"value\", 50) FROM \"http_req_duration\" WHERE \"sync_type\" = 'delta' AND $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series" }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "k6" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "title": "Sync Throughput (req/s)",
      "type": "timeseries",
      "targets": [
        { "alias": "full syncs", "query": "SELECT count(\"value\") FROM \"http_reqs\" WHERE \"sync_type\" = 'full' AND $timeFilter GROUP BY time($__interval) fill(0)", "rawQuery": true, "resultFormat": "time_series" },
        { "alias": "delta syncs", "query": "SELECT count(\"value\") FROM \"http_reqs\" WHERE \"sync_type\" = 'delta' AND $timeFilter GROUP BY time($__interval) fill(0)", "rawQuery": true, "resultFormat": "time_series" }
      ]
    },
