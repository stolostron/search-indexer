        { "alias": "related p95", "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE \"query_type\" = 'related' AND $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series" }
